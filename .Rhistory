# data-raw/gender_dictionary.R
# This script creates the built-in dictionary and saves it to /data as .RData
gender_dictionary <- tibble::tibble(
gendered = c(
"chairman","policeman","fireman","stewardess","mailman","businessman","salesman",
"spokesman","foreman","workman","mankind","manpower","manmade","manhours",
"manhole","manhunt","freshman","middleman","layman","craftsman","congressman",
"cameraman","serviceman","repairman","weatherman","anchorman","barman","doorman",
"handyman","deliveryman","crewman","gunman","sportsman","statesman","ombudsman",
"landlord","landlady","waitress","actress","hostess","cleaning lady","housewife",
"mothering","fathering","maternal instinct","paternal authority",
"he","him","his","guys","ladies and gentlemen","boys and girls",
"sir","madam","maiden name","man up","like a girl"
),
neutral = c(
"chair","police officer","firefighter","flight attendant","mail carrier","businessperson","salesperson",
"spokesperson","supervisor","worker","humankind","workforce","human-made","work hours",
"utility hole","search","first-year student","intermediary","non-expert","artisan","member of congress",
"camera operator","service member","repair technician","weather presenter","news anchor","bartender","door attendant",
"handy person","courier","crew member","shooter","athlete","leader","ombudsperson",
"property owner","property owner","server","actor","host","cleaner","homemaker",
"caring","parenting","caregiving tendency","parental authority",
"they","them","their","everyone","everyone","children",
"dear","dear","birth name","step up","inappropriately"
)
)
# Basic cleaning: lower-case dictionary for matching
gender_dictionary$gendered <- tolower(gender_dictionary$gendered)
gender_dictionary$neutral  <- tolower(gender_dictionary$neutral)
# Save as .RData inside /data so it is shipped with the package
usethis::use_data(gender_dictionary, overwrite = TRUE)
View(gender_dictionary)
View(gender_dictionary)
save(gender_dictionary, file = "gender_dictionary.RData")
setwd("~/GitHub/gendertext")
